# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (required) ---
# Project settings → API. The publishable key is safe in the browser: every
# table is protected by row-level security. A legacy anon key also works.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of the app, used in confirmation emails and share links.
# Optional locally (derived from the request), set it in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secret key ---
# Bypasses RLS. Used by `npm run seed`, and on the server for phone
# notifications and the scheduled jobs (never sent to the browser).
SUPABASE_SECRET_KEY=

# --- Phone notifications (optional) ---
# Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: URL push services can contact you at.
VAPID_SUBJECT=

# --- Scheduled jobs (morning digest, evening nudge) ---
# Vercel Cron sends it as a Bearer token; any long random string.
CRON_SECRET=

# --- Email (optional) ---
# Resend API key and a sender on a verified domain, e.g. ResearchFlow <hello@yourdomain.com>
RESEND_API_KEY=
EMAIL_FROM=

# --- AI (optional) ---
# Enables "Split into tasks with AI" on remarks and "Draft with AI" on weekly reports.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
